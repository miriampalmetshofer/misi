# Pooled Neon connection for normal application queries.
# Local development should point to the Neon dev/miriam branch.
# Production deployment should set the same variable name to the Neon production branch.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require"

# Direct Neon connection for migrations and schema changes.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require"

# Neon API automation.
# Required in GitHub Actions for preview branches, production restore branches, and cleanup.
# For local use, only set these if you are running Neon automation yourself.
NEON_API_KEY="neon_api_key"
NEON_PROJECT_ID="neon_project_id"
NEON_DATABASE_NAME="misi"
NEON_DATABASE_ROLE="neondb_owner"
NEON_PREVIEW_PARENT_BRANCH="production"
NEON_PRODUCTION_BRANCH="production"

# Vercel deployment automation.
# Required as GitHub Actions secrets for CI/CD deployments.
# For local use, only set these if you are running Vercel CLI deployment commands yourself.
VERCEL_TOKEN="vercel_token"
VERCEL_ORG_ID="vercel_org_id"
VERCEL_PROJECT_ID="vercel_project_id"
